    },
    {
      "id": "anima_turbo",
      "match": {
        "all": [
          "anima",
          "turbo"
        ]
      },
      "profile": "anima_turbo"
    },
    {
      "id": "anima_full",
      "match": {
        "all": [
          "anima"
        ],
        "not": [
          "turbo",
          "edit"
        ]
      },
      "profile": "anima_full"
    },
    {
      "id": "krea2_turbo",
      "match": {
        "all": [
          "krea2",
          "turbo"
        ]
      },
      "profile": "krea2_turbo"
    },
    {
